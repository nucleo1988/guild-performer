package-as: GuildPerformer
manual-changelog: CHANGELOG.md
enable-nolib-creation: no

move-folders:
  addon: GuildPerformer

ignore:
  - web
  - scripts
  - syncer
  - tools
  - docs
  - .github
  - CONTRIBUTING.md
  - README.md
  - LICENSE
  - release.bat
  - "*.md"
  - .gitignore
  - .gitattributes
